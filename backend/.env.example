DEBUG=True
ENVIRONMENT=development
APP_NAME=Shiksha Setu API
API_PREFIX=/api
FRONTEND_ORIGIN=http://localhost:5173

# Use Neon's pooled runtime connection string.
DATABASE_URL=postgresql+psycopg://user:password@host-pooler/database?sslmode=require&channel_binding=require

# Use Neon's direct connection for Alembic migrations when available.
DIRECT_DATABASE_URL=postgresql+psycopg://user:password@host/database?sslmode=require&channel_binding=require

JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# LLM settings are wired in a later implementation phase.
LLM_PROVIDER=ollama
OLLAMA_MODEL_NAME=your-llm-model-name
OLLAMA_BASE_URL=http://localhost:11434/v1

# Cloudinary server-side image uploads. Never expose these in frontend variables.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=shiksha-setu/donations
